name = "shenchao111/STA"

version = "0.1.0"

readme = "README.md"

license = "Apache-2.0"

repository = "https://github.com/shenchao111/STA"

keywords = [
  "sat",
  "solver",
  "cdcl",
  "dpll",
  "cnf",
  "dimacs",
  "sudoku",
  "boolean",
]

preferred_target = "wasm"

description = "A dependency-free SAT solver for MoonBit: DPLL and CDCL engines, DIMACS CNF parsing, and a Sudoku encoder, all compiling to wasm."
